{
  "name": "sound-crate",
  "version": "1.2.0",
  "description": "Student-friendly sound mixing with portable sessions and native DAW dragging",
  "author": "Matthew Russell",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node tests/regression.cjs && node tests/desktop.cjs && node tests/project-ui.cjs",
    "dist:mac": "electron-builder --mac --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.1",
    "fake-indexeddb": "6.2.5"
  },
  "build": {
    "appId": "com.mattsimoto.soundcrate",
    "productName": "Sound Crate",
    "files": ["index.html", "desktop/**/*", "package.json"],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.music",
      "identity": null
    }
  }
}
